{
  "name": "rest-desktop",
  "version": "1.2.1",
  "private": true,
  "description": "REST Desktop — gestão comercial local para Windows",
  "author": "Limitless, Lda",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "start": "electron .",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "test:desktop": "node scripts/smoke.cjs",
    "test:ui": "node scripts/ui-flows.cjs"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "qrcode": "^1.5.4",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.6",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "jsqr": "^1.4.0",
    "lucide-react": "0.546.0",
    "motion": "12.43.0",
    "pngjs": "^7.0.0",
    "prettier": "3.6.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "xlsx": "0.18.5"
  },
  "build": {
    "appId": "mz.limitless.rest.desktop",
    "productName": "REST Desktop",
    "copyright": "Copyright © 2026 Limitless, Lda",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "REST-Desktop-${version}-Setup.${ext}",
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "runAfterFinish": false
    },
    "publish": null,
    "electronDist": "node_modules/electron/dist"
  }
}
